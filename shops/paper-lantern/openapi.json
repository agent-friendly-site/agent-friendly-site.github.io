{
  "openapi": "3.1.0",
  "info": {
    "title": "Paper Lantern Stationery — Agent API (demo)",
    "version": "0.1.0",
    "description": "Demo only. Notebooks and pens for people who still write by hand. No real orders are taken. Agent-first storefront at https://agent-friendly-site.github.io/shops/paper-lantern/"
  },
  "servers": [
    {
      "url": "https://agent-friendly-site.github.io/shops/paper-lantern/"
    }
  ],
  "paths": {
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "responses": {
          "200": {
            "description": "Shop entry point and index"
          }
        }
      }
    },
    "/llms-full.txt": {
      "get": {
        "operationId": "getLlmsFull",
        "responses": {
          "200": {
            "description": "Full shop corpus: products and policies"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "This document"
          }
        }
      }
    },
    "/agent.json": {
      "get": {
        "operationId": "getAgentCard",
        "responses": {
          "200": {
            "description": "Agent card"
          }
        }
      }
    },
    "/api/catalog.json": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Product catalog"
          }
        }
      }
    },
    "/api/products.json": {
      "get": {
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "Product list with price and stock"
          }
        }
      }
    },
    "/policies.json": {
      "get": {
        "operationId": "getPolicies",
        "responses": {
          "200": {
            "description": "Shipping, returns, privacy"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcpStreamableHttp",
        "summary": "MCP Streamable HTTP (demo: documented, not live on GitHub Pages)",
        "description": "In production this is POST /mcp, Streamable HTTP, tools: list_products, get_product, create_order (mock), get_order. GitHub Pages is static-only, so this demo documents the endpoint in mcp.json instead of serving a live MCP server. See README.md / DISCOVERY.md."
      }
    }
  }
}
