{
  "openapi": "3.1.0",
  "info": {
    "title": "Terra Pots Ceramics — Agent API",
    "version": "0.4.1",
    "description": "Hand-thrown stoneware mugs and plates, made in Jingdezhen. Agent-first storefront at https://agent-friendly-site.github.io/shops/terra-pots/ Paths in this document are absolute from the host root, e.g. /shops/terra-pots/llms.txt."
  },
  "servers": [
    {
      "url": "https://agent-friendly-site.github.io"
    }
  ],
  "paths": {
    "/shops/terra-pots/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "responses": {
          "200": {
            "description": "Shop entry point and index"
          }
        }
      }
    },
    "/shops/terra-pots/llms-full.txt": {
      "get": {
        "operationId": "getLlmsFull",
        "responses": {
          "200": {
            "description": "Full shop corpus: products and policies"
          }
        }
      }
    },
    "/shops/terra-pots/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "This document"
          }
        }
      }
    },
    "/shops/terra-pots/agent.json": {
      "get": {
        "operationId": "getAgentCard",
        "responses": {
          "200": {
            "description": "Agent card"
          }
        }
      }
    },
    "/shops/terra-pots/api/catalog.json": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Product catalog"
          }
        }
      }
    },
    "/shops/terra-pots/api/products.json": {
      "get": {
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "Product list with price and stock"
          }
        }
      }
    },
    "/shops/terra-pots/policies.json": {
      "get": {
        "operationId": "getPolicies",
        "responses": {
          "200": {
            "description": "Shipping, returns, privacy"
          }
        }
      }
    },
    "/shops/terra-pots/mcp": {
      "post": {
        "operationId": "mcpStreamableHttp",
        "summary": "MCP Streamable HTTP (documented, not live on GitHub Pages)",
        "description": "In production this is POST /shops/terra-pots/mcp, Streamable HTTP, tools: list_products, get_product, create_order, get_order. GitHub Pages is static-only, so this documents the endpoint in mcp.json instead of serving a live MCP server. See README.md / DISCOVERY.md."
      }
    },
    "/shops/terra-pots/guide.md": {
      "get": {
        "operationId": "getShoppingGuide",
        "responses": {
          "200": {
            "description": "Shopping-assistant guide: conversation flow, questions, recommendations"
          }
        }
      }
    },
    "/shops/terra-pots/api/recommendations.json": {
      "get": {
        "operationId": "getRecommendations",
        "responses": {
          "200": {
            "description": "Structured recommendations, bundles and free-shipping tips"
          }
        }
      }
    },
    "/shops/terra-pots/api/presentation.json": {
      "get": {
        "operationId": "getPresentation",
        "responses": {
          "200": {
            "description": "Canonical presentation IR: products, options, actions, totals, Markdown fallback, per-client adapters"
          }
        }
      }
    },
    "/shops/terra-pots/api/payment.json": {
      "get": {
        "operationId": "getPayment",
        "responses": {
          "200": {
            "description": "Offline payment methods, flow, and proof submission"
          }
        }
      }
    }
  }
}
